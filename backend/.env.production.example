# Production settings for app.bestengineerpersada.com (docs/desain-v2.md B11, docs/DEPLOY_V2.md).
# Copy to backend/.env ON THE SERVER only, then fill APP_KEY (keep the old one) and DB_PASSWORD there.
# Never commit backend/.env. Never put a real password in this file.
APP_NAME="Stok Gudang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.bestengineerpersada.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u860192084_aplikasi_sulis
DB_USERNAME=u860192084_aplikasi_sulis
DB_PASSWORD=

# Stateless API with Bearer tokens: no session cookie. The rate limiter needs the database cache.
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Same origin (the SPA and /api are on one domain): no CORS origins.
CORS_ALLOWED_ORIGINS=
